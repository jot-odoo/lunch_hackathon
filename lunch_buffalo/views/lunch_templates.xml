<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="lunch_buffalo.index" inherit_id="website_event.index" primary="True">
    </template>

    <template id="index_topbar" inherit_id="website_event.index_topbar">
        <xpath expr="//div[hasclass('o_wevent_index_topbar_filters')]/h2" position="replace">
            <h2 class="h4 my-0 me-auto pe-sm-4">Lunch</h2>
        </xpath>
        <xpath expr="//t[@t-foreach='categories']" position="replace"/>
    </template>

    <template id="events_search_box_input" inherit_id="website_event.events_search_box_input">
        <xpath expr="//t[@t-set='placeholder']" position="attributes">
            <attribute name="t-value">"search.."</attribute>
        </xpath>
    </template>

    <template id="events_list" inherit_id="website_event.events_list">
        <p t-elif="searches['tags']" position="replace"/>
    </template>
</odoo>
