<odoo>
    <!-- Menu Form View -->
    <record id="view_food_menu_form" model="ir.ui.view">
        <field name="name">menu.form</field>
        <field name="model">menu</field>
        <field name="arch" type="xml">
            <form string="Menu">
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- <field name="date_start" 
                               help="Select the first day of the menu week, typically Monday."/> -->
                        <!-- <field name="date_end" 
                               help="Select the last day of the menu week, typically Friday."/> -->
                        <field name="food_ids" widget="many2many_tags" 
                               help="Select food items included in this menu."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu list (List) View -->
    <record id="view_food_menu_list" model="ir.ui.view">
        <field name="name">menu.list</field>
        <field name="model">menu</field>
        <field name="arch" type="xml">
            <list string="Menus">
                <field name="name"/>
                <!-- <field name="date_start"/> -->
                <!-- <field name="date_end"/> -->
            </list>
        </field>
    </record>

    <!-- Menu Action -->
    <record id="action_food_menu" model="ir.actions.act_window">
        <field name="name">Menus</field>
        <field name="res_model">menu</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create weekly menus here by selecting dates and food items.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_lunch_root" name="Lunch" sequence="10"/>
    <menuitem id="menu_food_menu_root" name="Menus" parent="menu_lunch_root" action="action_food_menu" sequence="1"/>
</odoo>
